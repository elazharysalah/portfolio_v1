# Copy to .env.production on the VPS (never commit real secrets)

# Postgres (used by docker-compose.prod.yml)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=portfolio

# App
DATABASE_URL=postgresql://portfolio:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/portfolio?schema=public
NEXTAUTH_URL=https://elazharysalah.com
NEXTAUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_32CHARS_MIN
ADMIN_EMAIL=admin@elazharysalah.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Optional Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
